{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "verTEX",
  "mainBinaryName": "verTEX",
  "version": "../package.json",
  "identifier": "com.vertex.editor",
  "build": {
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "node scripts/serve.mjs",
    "frontendDist": "../build/web",
    "beforeBuildCommand": "node scripts/stage.mjs"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQTM5NzE2MTFFNzQwREIKUldUYlFPY1JGcGVqRTYySWk3NmNLT0lKSUh6YU90TnI2NUpxWUZTZmUvck40NXhJMjNsOTlJYmMK",
      "endpoints": [
        "https://github.com/mku91/verTEX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
